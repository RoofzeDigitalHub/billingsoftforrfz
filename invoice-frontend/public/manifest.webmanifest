{
  "name": "Roofze Digital - Billing & Invoicing",
  "short_name": "Roofze Billing",
  "description": "Smart Billing, GST Invoicing, Expenses & Client Ledger by Roofze Digital Hub LLP",
  "start_url": "/dashboard",
  "scope": "/",
  "id": "/dashboard",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#020617",
  "theme_color": "#0f172a",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/roofze-logo.png",
      "sizes": "200x200",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Create Invoice",
      "short_name": "New Invoice",
      "description": "Create a new GST or non-GST invoice",
      "url": "/dashboard/invoices/create",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Expenses & Cash",
      "short_name": "Expenses",
      "description": "View and record business expenses",
      "url": "/dashboard/expenses",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Client Ledger",
      "short_name": "Ledger",
      "description": "View client ledger statements",
      "url": "/dashboard/reports/client-ledger",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
